# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# SMTP (email)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Flouci Payment API (https://docs.flouci.com)
# Authorization used by the backend: Bearer <FLOUCI_PUBLIC_KEY>:<FLOUCI_PRIVATE_KEY>
# NEVER expose FLOUCI_PRIVATE_KEY to the browser — server-side only.
FLOUCI_PUBLIC_KEY=
FLOUCI_PRIVATE_KEY=
